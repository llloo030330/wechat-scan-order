.page-container {
  min-height: 100vh;
  padding: 80rpx 32rpx;
  background: #f7f4ef;
}

.login-card {
  padding: 48rpx 32rpx;
  border: 1rpx solid #f0e8e1;
  border-top: 7rpx solid #ff6b35;
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(74, 55, 40, 0.07);
}

.title {
  color: #2d2926;
  font-size: 38rpx;
  font-weight: bold;
  text-align: center;
}

.tip {
  margin-top: 16rpx;
  color: #81776f;
  font-size: 26rpx;
  line-height: 40rpx;
  text-align: center;
}

.verify-button {
  height: 82rpx;
  margin-top: 40rpx;
  border-radius: 41rpx;
  color: #ffffff;
  font-size: 28rpx;
  line-height: 82rpx;
  background: #ff6b35;
  box-shadow: 0 8rpx 20rpx rgba(255, 107, 53, 0.2);
}
