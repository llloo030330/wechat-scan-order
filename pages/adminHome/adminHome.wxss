.page-container {
  min-height: 100vh;
  padding: 28rpx;
  background: #f5f5f5;
}

.header-card,
.menu-card,
.unauthorized-card {
  padding: 30rpx;
  margin-bottom: 24rpx;
  border-radius: 18rpx;
  background: #ffffff;
}

.title {
  color: #222222;
  font-size: 38rpx;
  font-weight: bold;
}

.message {
  margin-top: 12rpx;
  color: #777777;
  font-size: 25rpx;
}

.menu-button,
.login-button,
.logout-button {
  height: 82rpx;
  margin-bottom: 18rpx;
  border-radius: 41rpx;
  color: #ffffff;
  font-size: 28rpx;
  line-height: 82rpx;
  background: #ff6b35;
}

.menu-button--primary {
  background: #1683ff;
}

.menu-button--secondary {
  background: #666666;
}

.logout-button {
  margin-bottom: 0;
  background: #333333;
}

.unauthorized-title {
  color: #d93025;
  font-size: 32rpx;
  font-weight: bold;
}

.unauthorized-tip {
  margin: 14rpx 0 30rpx;
  color: #777777;
  font-size: 25rpx;
}

.login-button {
  margin-bottom: 0;
  background: #e67e22;
}

.empty {
  padding: 160rpx 0;
  color: #999999;
  text-align: center;
}

/* Visual refresh */
.page-container {
  background: #f7f4ef;
}

.header-card,
.menu-card,
.unauthorized-card {
  border: 1rpx solid #f0e8e1;
  border-radius: 22rpx;
  box-shadow: 0 10rpx 28rpx rgba(74, 55, 40, 0.07);
}

.header-card {
  color: #ffffff;
  background: linear-gradient(135deg, #ff7a3d, #e95725);
}

.header-card .title,
.header-card .message {
  color: #ffffff;
}

.header-card .message {
  opacity: 0.85;
}

.menu-section-title {
  margin: 4rpx 0 20rpx;
  color: #2d2926;
  font-size: 28rpx;
  font-weight: bold;
}

.menu-button,
.login-button,
.logout-button {
  border-radius: 16rpx;
}

.menu-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.menu-button {
  width: 100%;
  margin: 0;
  color: #5d534c;
  background: #faf8f5;
  border: 1rpx solid #eee4dc;
}

.menu-button--primary {
  color: #ffffff;
  background: #ff6b35;
  border-color: #ff6b35;
  box-shadow: 0 7rpx 18rpx rgba(255, 107, 53, 0.18);
}

.logout-button {
  margin-top: 28rpx;
}
