.page-container {
  min-height: 100vh;
  padding: 24rpx;
  background: #f5f5f5;
}

.form-card,
.table-card {
  padding: 28rpx;
  margin-bottom: 24rpx;
  border-radius: 16rpx;
  background: #ffffff;
}

.form-title {
  margin-bottom: 24rpx;
  color: #222222;
  font-size: 32rpx;
  font-weight: bold;
}

.form-input {
  height: 78rpx;
  padding: 0 20rpx;
  margin-bottom: 18rpx;
  border-radius: 10rpx;
  background: #f7f7f7;
  font-size: 26rpx;
}

.submit-button,
.cancel-button,
.enter-menu-button,
.generate-code-button {
  height: 78rpx;
  border-radius: 39rpx;
  font-size: 28rpx;
  line-height: 78rpx;
}

.submit-button,
.enter-menu-button,
.generate-code-button {
  color: #ffffff;
  background: #ff6b35;
}

.cancel-button {
  margin-top: 18rpx;
  color: #666666;
  background: #eeeeee;
}

.table-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.table-no {
  color: #222222;
  font-size: 32rpx;
  font-weight: bold;
}

.table-name {
  margin-top: 10rpx;
  color: #666666;
  font-size: 26rpx;
}

.table-status {
  color: #999999;
  font-size: 26rpx;
}

.table-status--enabled {
  color: #16a085;
}

.button-row {
  display: flex;
  gap: 14rpx;
  margin-top: 24rpx;
}

.small-button {
  flex: 1;
  height: 64rpx;
  margin: 0;
  border: 1rpx solid #dddddd;
  border-radius: 32rpx;
  color: #666666;
  font-size: 24rpx;
  line-height: 64rpx;
  background: #ffffff;
}

.delete-button {
  color: #ffffff;
  background: #d93025;
}

.enter-menu-button {
  margin-top: 24rpx;
  background: #16a085;
}

.generate-code-button {
  margin-top: 18rpx;
  background: #1683ff;
}

.clear-table-button {
  height: 78rpx;
  margin-top: 18rpx;
  border-radius: 39rpx;
  color: #ffffff;
  font-size: 28rpx;
  line-height: 78rpx;
  background: #d95345;
}

.session-status {
  padding: 12rpx 16rpx;
  margin-top: 18rpx;
  border-radius: 12rpx;
  color: #756a62;
  font-size: 24rpx;
  background: #faf8f5;
}

.code-section {
  margin-top: 24rpx;
  text-align: center;
}

.table-code {
  width: 360rpx;
  height: 360rpx;
  border-radius: 12rpx;
  background: #f7f7f7;
}

.code-tip {
  margin-top: 10rpx;
  color: #999999;
  font-size: 24rpx;
}

.empty {
  padding: 100rpx 0;
  color: #999999;
  text-align: center;
}

/* Visual refresh */
.page-container {
  background: #f7f4ef;
}

.form-card,
.table-card {
  border: 1rpx solid #f0e8e1;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(74, 55, 40, 0.06);
}

.form-card {
  border-top: 7rpx solid #ff6b35;
}

.form-input {
  border: 1rpx solid #eee4dc;
  border-radius: 14rpx;
  background: #faf8f5;
}

.submit-button,
.generate-code-button {
  background: #ff6b35;
}

.table-no {
  color: #e95323;
  font-size: 40rpx;
}

.table-status {
  padding: 7rpx 14rpx;
  border-radius: 16rpx;
  background: #efedeb;
}

.table-status--enabled {
  color: #187d55;
  background: #eaf8f1;
}

.small-button {
  border-color: #e8dfd8;
  color: #6f6259;
  background: #faf8f5;
}

.delete-button {
  border-color: #f0cbc5;
  color: #b53d30;
  background: #fff1ee;
}

.enter-menu-button {
  background: #2a9d73;
}

.code-section {
  padding: 22rpx;
  border-radius: 16rpx;
  background: #faf8f5;
}

.table-code {
  border: 1rpx solid #eee4dc;
  background: #ffffff;
}
