.menu-page {
  position: relative;
  height: 100vh;
  padding-bottom: 110rpx;
  background: #ffffff;
}

.table-info {
  position: fixed;
  top: 126rpx;
  right: 0;
  left: 0;
  z-index: 20;
  height: 52rpx;
  color: #333333;
  font-size: 26rpx;
  font-weight: bold;
  line-height: 52rpx;
  text-align: center;
  background: #fff7f2;
}

.session-error {
  position: fixed;
  top: 178rpx;
  right: 0;
  left: 0;
  z-index: 21;
  padding: 12rpx 20rpx;
  color: #a84838;
  font-size: 23rpx;
  text-align: center;
  background: #fff1ee;
}

.store-header {
  position: fixed;
  top: 0;
  right: 0;
  left: 0;
  z-index: 20;
  min-height: 130rpx;
  padding: 14rpx 24rpx;
  text-align: center;
  background: #ffffff;
  box-sizing: border-box;
}

.store-name {
  color: #222222;
  font-size: 32rpx;
  font-weight: bold;
}

.store-notice {
  overflow: hidden;
  margin-top: 8rpx;
  color: #ff6b35;
  font-size: 23rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.menu-content {
  display: flex;
  height: 100%;
  padding-top: 178rpx;
}

.category-list {
  width: 190rpx;
  height: 100%;
  background: #f5f5f5;
}

.category-item {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 110rpx;
  padding: 20rpx 12rpx;
  color: #666666;
  text-align: center;
}

.category-item--active {
  position: relative;
  color: #222222;
  font-weight: bold;
  background: #ffffff;
}

.category-item--active::before {
  position: absolute;
  left: 0;
  width: 8rpx;
  height: 44rpx;
  border-radius: 0 8rpx 8rpx 0;
  background: #ff6b35;
  content: '';
}

.dish-list {
  flex: 1;
  height: 100%;
  padding: 24rpx;
  background: #ffffff;
}

.dish-card {
  display: flex;
  padding-bottom: 28rpx;
  margin-bottom: 28rpx;
  border-bottom: 1rpx solid #eeeeee;
}

.dish-image {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  color: #ff6b35;
  font-size: 26rpx;
  background: #f2f2f2;
}

.dish-info {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  margin-left: 20rpx;
}

.dish-name {
  overflow: hidden;
  color: #222222;
  font-size: 32rpx;
  font-weight: bold;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dish-description {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 12rpx;
  color: #999999;
  font-size: 24rpx;
  line-height: 34rpx;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.dish-options-tip {
  margin-top: 8rpx;
  color: #ff6b35;
  font-size: 22rpx;
}

.dish-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: auto;
}

.dish-price {
  color: #ff4d2e;
  font-size: 34rpx;
  font-weight: bold;
}

.quantity-control {
  display: flex;
  align-items: center;
}

.quantity-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  min-width: 52rpx;
  height: 52rpx;
  padding: 0;
  border-radius: 50%;
  font-size: 38rpx;
  line-height: 52rpx;
}

.quantity-button--add {
  color: #ffffff;
  background: #ff6b35;
}

.quantity-button--closed {
  background: #bbbbbb;
}

.quantity-button--reduce {
  color: #ff6b35;
  border: 2rpx solid #ff6b35;
  background: #ffffff;
}

.dish-count {
  min-width: 56rpx;
  color: #333333;
  text-align: center;
}

.sold-out-text {
  color: #999999;
  font-size: 24rpx;
}

.cart-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 110rpx;
  padding-left: 28rpx;
  background: #2f2f2f;
}

.cart-summary {
  display: flex;
  align-items: center;
}

.cart-icon {
  position: relative;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: bold;
}

.cart-badge {
  position: absolute;
  top: -26rpx;
  right: -28rpx;
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 8rpx;
  border-radius: 18rpx;
  color: #ffffff;
  font-size: 22rpx;
  line-height: 36rpx;
  text-align: center;
  background: #ff4d2e;
}

.cart-total {
  margin-left: 42rpx;
}

.cart-total-label {
  margin-right: 12rpx;
  color: #cccccc;
  font-size: 24rpx;
}

.cart-total-price {
  color: #ffffff;
  font-size: 36rpx;
  font-weight: bold;
}

.checkout-button {
  width: 220rpx;
  height: 110rpx;
  margin: 0;
  border-radius: 0;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: bold;
  line-height: 110rpx;
  background: #ff6b35;
}

.checkout-button--disabled {
  color: #999999;
  background: #555555;
}

.spec-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.45);
}

.spec-panel {
  width: 100%;
  max-height: 80vh;
  padding: 32rpx 28rpx 40rpx;
  overflow-y: auto;
  border-radius: 28rpx 28rpx 0 0;
  background: #ffffff;
}

.cart-panel {
  width: 100%;
  max-height: 70vh;
  padding: 32rpx 28rpx 40rpx;
  overflow-y: auto;
  border-radius: 28rpx 28rpx 0 0;
  background: #ffffff;
}

.cart-panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.cart-panel-title {
  margin-bottom: 0;
}

.clear-cart-button {
  width: auto;
  min-width: 92rpx;
  height: 54rpx;
  padding: 0 18rpx;
  margin: 0;
  border-radius: 27rpx;
  color: #b94b3e;
  font-size: 23rpx;
  line-height: 54rpx;
  background: #fff1ee;
}

.cart-item {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #eeeeee;
}

.cart-item-main {
  flex: 1;
  min-width: 0;
}

.cart-item-name {
  color: #333333;
  font-size: 28rpx;
  font-weight: bold;
}

.cart-item-options,
.cart-item-remark,
.cart-item-price {
  margin-top: 7rpx;
  color: #888888;
  font-size: 23rpx;
  line-height: 32rpx;
}

.cart-item-remark {
  color: #ff6b35;
}

.cart-item-price {
  color: #333333;
}

.cart-item-actions {
  display: flex;
  align-items: center;
  margin-left: 18rpx;
}

.cart-item-button {
  width: 50rpx;
  min-width: 50rpx;
  height: 50rpx;
  padding: 0;
  border: 1rpx solid #ff6b35;
  border-radius: 25rpx;
  color: #ff6b35;
  font-size: 32rpx;
  line-height: 48rpx;
  background: #ffffff;
}

.cart-item-button--add {
  color: #ffffff;
  background: #ff6b35;
}

.cart-item-count {
  min-width: 54rpx;
  text-align: center;
}

.spec-title {
  margin-bottom: 28rpx;
  color: #222222;
  font-size: 34rpx;
  font-weight: bold;
}

.spec-group {
  margin-bottom: 24rpx;
}

.spec-group-name {
  margin-bottom: 14rpx;
  color: #333333;
  font-size: 27rpx;
}

.spec-values {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.spec-value {
  width: auto;
  min-width: 130rpx;
  height: 62rpx;
  margin: 0;
  padding: 0 24rpx;
  border: 1rpx solid #dddddd;
  border-radius: 31rpx;
  color: #666666;
  font-size: 24rpx;
  line-height: 62rpx;
  background: #ffffff;
}

.spec-value--active {
  border-color: #ff6b35;
  color: #ffffff;
  background: #ff6b35;
}

.item-remark-input {
  width: 100%;
  height: 120rpx;
  padding: 18rpx;
  margin-top: 14rpx;
  border-radius: 12rpx;
  font-size: 25rpx;
  background: #f7f7f7;
}

.spec-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 26rpx;
}

.spec-cancel,
.spec-confirm {
  flex: 1;
  height: 76rpx;
  border-radius: 38rpx;
  font-size: 27rpx;
  line-height: 76rpx;
}

.spec-cancel {
  color: #666666;
  background: #eeeeee;
}

.spec-confirm {
  color: #ffffff;
  background: #ff6b35;
}

/* Visual refresh */
.menu-page {
  background: #f7f4ef;
}

.store-header {
  padding: 18rpx 28rpx 16rpx;
  text-align: center;
  background: linear-gradient(135deg, #fffaf4 0%, #ffffff 72%);
  box-shadow: 0 8rpx 24rpx rgba(74, 55, 40, 0.07);
}

.store-name {
  color: #2d2926;
  font-size: 38rpx;
}

.store-notice {
  display: inline-block;
  max-width: 100%;
  padding: 7rpx 14rpx;
  border-radius: 18rpx;
  color: #9a5b32;
  background: #fff0e5;
}

.table-info {
  color: #8a4f2d;
  background: #fff6ed;
  border-bottom: 1rpx solid #f3e4d7;
}

.category-list {
  background: #f1ede8;
}

.category-item {
  color: #81776f;
}

.category-item--active {
  color: #ff6b35;
  background: #fffaf6;
}

.dish-list {
  padding: 20rpx;
  background: #f7f4ef;
}

.dish-card {
  padding: 20rpx;
  margin-bottom: 18rpx;
  border: 0;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(74, 55, 40, 0.07);
}

.dish-card--sold-out {
  background: #f2f0ee;
  box-shadow: none;
}

.dish-card--sold-out .dish-image,
.dish-card--sold-out .dish-info {
  opacity: 0.58;
}

.dish-image {
  width: 170rpx;
  height: 170rpx;
  border-radius: 18rpx;
}

.dish-name {
  color: #2d2926;
  font-size: 30rpx;
}

.dish-price {
  color: #e95323;
  font-size: 36rpx;
}

.dish-options-tip {
  align-self: flex-start;
  padding: 4rpx 12rpx;
  border-radius: 14rpx;
  color: #a75b2d;
  background: #fff0e5;
}

.quantity-button--add {
  box-shadow: 0 6rpx 16rpx rgba(255, 107, 53, 0.3);
}

.sold-out-text {
  padding: 7rpx 14rpx;
  border-radius: 18rpx;
  color: #888078;
  background: #e5e1dd;
}

.cart-bar {
  right: 18rpx;
  bottom: 18rpx;
  left: 18rpx;
  height: 104rpx;
  padding-left: 28rpx;
  border-radius: 52rpx;
  background: #302b28;
  box-shadow: 0 12rpx 34rpx rgba(45, 41, 38, 0.26);
  overflow: hidden;
}

.checkout-button {
  height: 104rpx;
  line-height: 104rpx;
}

.spec-mask {
  background: rgba(35, 29, 25, 0.52);
}

.spec-panel,
.cart-panel {
  border-radius: 32rpx 32rpx 0 0;
  box-shadow: 0 -12rpx 32rpx rgba(45, 41, 38, 0.12);
}

.spec-title {
  color: #2d2926;
  font-size: 36rpx;
}

.spec-group {
  padding: 20rpx;
  border-radius: 16rpx;
  background: #faf8f5;
}

.spec-group-name,
.remark-label {
  margin-bottom: 14rpx;
  color: #5d534c;
  font-size: 26rpx;
  font-weight: bold;
}

.remark-label {
  margin-top: 12rpx;
}

.spec-value--active {
  box-shadow: 0 5rpx 14rpx rgba(255, 107, 53, 0.2);
}

.item-remark-input {
  border: 1rpx solid #eee5dd;
  background: #faf8f5;
}

.spec-confirm {
  box-shadow: 0 8rpx 20rpx rgba(255, 107, 53, 0.24);
}

.menu-state {
  padding: 120rpx 24rpx;
  color: #91867e;
  text-align: center;
}

.menu-state--error {
  color: #a84838;
}

.retry-button {
  width: 190rpx;
  height: 66rpx;
  margin-top: 24rpx;
  border-radius: 33rpx;
  color: #ffffff;
  font-size: 25rpx;
  line-height: 66rpx;
  background: #ff6b35;
}

.menu-error-tip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 18rpx;
  margin-bottom: 16rpx;
  border-radius: 14rpx;
  color: #a84838;
  font-size: 23rpx;
  background: #fff1ee;
}

.inline-retry-button {
  width: 110rpx;
  height: 52rpx;
  margin: 0 0 0 16rpx;
  border-radius: 26rpx;
  color: #ffffff;
  font-size: 22rpx;
  line-height: 52rpx;
  background: #ff6b35;
}
