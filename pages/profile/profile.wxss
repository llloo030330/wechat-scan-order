.page-container {
  min-height: 100vh;
  padding: 28rpx;
  background: #f5f5f5;
}

.header-card,
.menu-card {
  margin-bottom: 24rpx;
  border-radius: 18rpx;
  background: #ffffff;
}

.header-card {
  padding: 42rpx 30rpx;
}

.title {
  color: #222222;
  font-size: 40rpx;
  font-weight: bold;
}

.subtitle {
  margin-top: 10rpx;
  color: #999999;
  font-size: 25rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  padding: 0 28rpx;
  border-bottom: 1rpx solid #eeeeee;
  color: #333333;
  font-size: 28rpx;
}

.menu-item:last-child {
  border-bottom: 0;
}

.admin-item {
  color: #ff6b35;
}

.arrow {
  color: #bbbbbb;
  font-size: 38rpx;
}

.version {
  padding: 28rpx;
  color: #999999;
  font-size: 24rpx;
  text-align: center;
}

/* Visual refresh */
.page-container {
  background: #f7f4ef;
}

.header-card {
  color: #ffffff;
  background: linear-gradient(135deg, #ff7a3d, #e95725);
  box-shadow: 0 12rpx 30rpx rgba(233, 87, 37, 0.2);
}

.header-card .title,
.header-card .subtitle {
  color: #ffffff;
}

.header-card .subtitle {
  opacity: 0.82;
}

.menu-card {
  border: 1rpx solid #f0e8e1;
  box-shadow: 0 8rpx 24rpx rgba(74, 55, 40, 0.06);
}

.menu-item {
  min-height: 108rpx;
}

.admin-item {
  color: #7f6c5f;
  background: #faf8f5;
}
