.page-container {
  min-height: 100vh;
  padding: 24rpx;
  background: #f5f5f5;
}

.order-card {
  padding: 28rpx;
  margin-bottom: 24rpx;
  border-radius: 16rpx;
  background: #ffffff;
}

.order-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.order-id {
  overflow: hidden;
  margin-top: 14rpx;
  color: #aaaaaa;
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.table-label {
  color: #999999;
  font-size: 22rpx;
}

.table-no {
  margin-top: 4rpx;
  color: #222222;
  font-size: 42rpx;
  font-weight: bold;
}

.status {
  flex-shrink: 0;
  margin-left: 20rpx;
  color: #ff6b35;
  font-size: 26rpx;
  font-weight: bold;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
  color: #666666;
  font-size: 26rpx;
}

.total-price {
  color: #ff4d2e;
  font-size: 32rpx;
  font-weight: bold;
}

.cancel-reason {
  margin-top: 14rpx;
  color: #d93025;
  font-size: 24rpx;
}

.shared-items {
  padding: 14rpx 0;
  margin-top: 18rpx;
  border-top: 1rpx solid #f1ebe6;
  border-bottom: 1rpx solid #f1ebe6;
}

.shared-item {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 10rpx 0;
}

.shared-item-main {
  display: flex;
  flex: 1;
  flex-direction: column;
}

.shared-item-name {
  color: #333333;
  font-size: 26rpx;
  font-weight: bold;
}

.shared-item-options,
.shared-item-remark {
  margin-top: 5rpx;
  color: #8a6a54;
  font-size: 22rpx;
}

.shared-item-remark {
  color: #e06435;
}

.shared-item-subtotal {
  margin-left: 20rpx;
  color: #e95323;
  font-size: 25rpx;
  font-weight: bold;
}

.empty {
  padding-top: 220rpx;
  color: #999999;
  text-align: center;
}

.empty-tip {
  margin-top: 16rpx;
  font-size: 24rpx;
}

/* Visual refresh */
.page-container {
  background: #f7f4ef;
}

.order-card {
  border: 1rpx solid #f0e8e1;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(74, 55, 40, 0.07);
}

.table-no {
  color: #e95323;
  font-size: 48rpx;
}

.status {
  padding: 8rpx 18rpx;
  border-radius: 20rpx;
  background: #fff0e7;
}

.status--making {
  color: #236fa1;
  background: #eaf5fd;
}

.status--completed {
  color: #187d55;
  background: #eaf8f1;
}

.status--canceled {
  color: #77716c;
  background: #efedeb;
}

.total-price {
  color: #e95323;
}

.cancel-reason {
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  background: #fff1ee;
}

.empty {
  margin-top: 80rpx;
  padding: 100rpx 30rpx;
  border-radius: 20rpx;
  background: #ffffff;
}

.error-state {
  color: #a84838;
}

.retry-button {
  width: 190rpx;
  height: 66rpx;
  margin-top: 24rpx;
  border-radius: 33rpx;
  color: #ffffff;
  font-size: 25rpx;
  line-height: 66rpx;
  background: #ff6b35;
}

.inline-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 18rpx;
  margin-bottom: 18rpx;
  border-radius: 14rpx;
  color: #a84838;
  font-size: 23rpx;
  background: #fff1ee;
}

.inline-retry-button {
  width: 100rpx;
  height: 52rpx;
  margin: 0;
  border-radius: 26rpx;
  color: #ffffff;
  font-size: 22rpx;
  line-height: 52rpx;
  background: #ff6b35;
}
